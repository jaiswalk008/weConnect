// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============== Enums ==============

enum FriendStatus {
  SENT
  ACCEPTED
  RECEIVED
}

enum ChatType {
  PERSONAL
  GROUP
}

enum MessageStatusType {
  SENT
  DELIVERED
  READ
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum NotificationType {
  MESSAGE
  FRIEND_REQUEST
  GROUP_INVITE
}

// ============== User Management ==============

model User {
  id                       Int               @id @default(autoincrement())
  username                 String            @unique @db.VarChar(100)
  name                     String            @db.VarChar(255)
  email                    String            @unique @db.VarChar(255)
  profile_image            String?           @db.VarChar(500)
  password                 String            @db.VarChar(255)
  status                   String?           @db.VarChar(500)
  last_seen                DateTime?
  google_id                String?
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt

  // Relations
  sent_friend_requests     Friend[]          @relation("SentFriendRequests")
  received_friend_requests Friend[]          @relation("ReceivedFriendRequests")
  chat_participants        ChatParticipant[]
  messages                 Message[]
  message_statuses         MessageStatus[]
  notifications            Notification[]
  created_chats            Chat[]            @relation("CreatedChats")

  @@map("users")
}

// ============== Contacts/Friends ==============

model Friend {
  id             Int          @id @default(autoincrement())
  user_id        Int
  friend_user_id Int
  status         FriendStatus @default(SENT)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  // Relations
  user        User @relation("SentFriendRequests", fields: [user_id], references: [id])
  friend_user User @relation("ReceivedFriendRequests", fields: [friend_user_id], references: [id])

  @@unique([user_id, friend_user_id])
  @@index([user_id])
  @@index([friend_user_id])
  @@map("friends")
}

// ============== Chat/Conversation Management ==============

model Chat {
  id              Int               @id @default(autoincrement())
  chat_type       ChatType
  chat_name       String?           @db.VarChar(255)
  chat_image      String?           @db.VarChar(500)
  last_message_id Int?              @unique
  created_by      Int
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  // Relations
  created_by_user User              @relation("CreatedChats", fields: [created_by], references: [id])
  participants    ChatParticipant[]
  messages        Message[]         @relation("ChatMessages")
  group           Group?
  last_message    Message?          @relation("LastMessage", fields: [last_message_id], references: [id])

  @@index([created_by])
  @@map("chats")
}

// ============== Chat Participants ==============

model ChatParticipant {
  id                   Int       @id @default(autoincrement())
  chat_id              Int
  user_id              Int
  role                 String    @default("member") @db.VarChar(20)
  joined_at            DateTime  @default(now())
  left_at              DateTime?
  is_active            Boolean   @default(true)
  unread_count         Int       @default(0)
  last_read_message_id Int?

  // Relations
  chat              Chat     @relation(fields: [chat_id], references: [id])
  user              User     @relation(fields: [user_id], references: [id])
  last_read_message Message? @relation("ReadMessages", fields: [last_read_message_id], references: [id])

  @@unique([chat_id, user_id])
  @@index([user_id])
  @@index([chat_id])
  @@index([is_active])
  @@map("chat_participants")
}

// ============== Messages ==============

model Message {
  id         Int        @id @default(autoincrement())
  chat_id    Int
  sender_id  Int
  content    String?    @db.Text
  media_url  String?    @db.VarChar(500)
  media_type MediaType?
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  // Relations
  chat              Chat              @relation("ChatMessages", fields: [chat_id], references: [id])
  sender            User              @relation(fields: [sender_id], references: [id])
  message_statuses  MessageStatus[]
  chat_last_message Chat?             @relation("LastMessage")
  read_by           ChatParticipant[] @relation("ReadMessages")

  @@index([chat_id])
  @@index([sender_id])
  @@index([created_at])
  @@map("messages")
}

// ============== Message Status ==============

model MessageStatus {
  id               Int               @id @default(autoincrement())
  message_id       Int
  user_id          Int
  status           MessageStatusType @default(SENT)
  status_timestamp DateTime          @default(now())

  // Relations
  message Message @relation(fields: [message_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])

  @@unique([message_id, user_id])
  @@index([message_id])
  @@index([user_id])
  @@map("message_statuses")
}

// ============== Group Details ==============

model Group {
  id          Int      @id @default(autoincrement())
  chat_id     Int      @unique
  description String?  @db.Text
  group_id String   @unique @default(uuid()) @db.Uuid
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  chat Chat @relation(fields: [chat_id], references: [id])

  @@map("groups")
}

// ============== Notifications ==============

model Notification {
  id           Int              @id @default(autoincrement())
  user_id      Int
  type         NotificationType
  reference_id Int?
  content      String?          @db.Text
  is_read      Boolean          @default(false)
  created_at   DateTime         @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("notifications")
}
